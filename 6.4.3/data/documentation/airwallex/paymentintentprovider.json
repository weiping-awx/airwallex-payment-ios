ntent()","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"amount"},{"text":" should be zero for recurring-only payments (no immediate charge)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"createPaymentIntent()","type":"codeVoice"},{"text":" method will only be called once, and the result is cached","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"createPaymentIntent()","type":"codeVoice"},{"text":" throws an error, the payment flow will fail","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"Session"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AWXPaymentIntent"}]}],"type":"aside","name":"See Also"}],"kind":"content"}],"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"title":"PaymentIntentProvider","modules":[{"name":"Airwallex"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PaymentIntentProvider","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"PaymentIntentProvider","kind":"identifier"}],"roleHeading":"Protocol","symbolKind":"protocol","externalID":"c:@M@Airwallex@objc(pl)PaymentIntentProvider"},"identifier":{"url":"doc:\/\/org.cocoapods.Airwallex\/documentation\/Airwallex\/PaymentIntentProvider","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/org.cocoapods.Airwallex\/documentation\/Airwallex"]]},"abstract":[{"type":"text","text":"A protocol for providing payment intents on-demand during the payment flow."}],"references":{"doc://org.cocoapods.Airwallex/documentation/Airwallex/PaymentIntentProvider/currency":{"url":"\/documentation\/airwallex\/paymentintentprovider\/currency","identifier":"doc:\/\/org.cocoapods.Airwallex\/documentation\/